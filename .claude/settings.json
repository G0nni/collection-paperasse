{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm verify)",
      "Bash(pnpm audit *)",
      "Bash(pnpm preview *)",
      "Bash(pnpm --filter *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  }
}
