---
// Aperçu du Look 02 : l'acte de pari de Juré Craché, punaisé, avec son sceau de cire.
import "@fontsource/young-serif/400.css";
import "@fontsource/courier-prime/400.css";

type Props = { label: string };

const { label } = Astro.props;
---

<div class="acte" role="img" aria-label={label}>
  <span class="pin" aria-hidden="true"></span>
  <div class="frame">
    <div class="text">
      <p class="republic">République des potes</p>
      <p class="title">Acte de pari</p>
      <p class="terms">
        <span class="line">Kevin arrivera en retard samedi.</span>
        <span class="line">Enjeu&nbsp;: un (1) kebab.</span>
      </p>
    </div>
    <svg class="seal" width="58" height="58" viewBox="0 0 150 150" aria-hidden="true">
      <circle
        cx="75"
        cy="75"
        r="62"
        fill="#9E2A24"
        stroke="#9E2A24"
        stroke-width="12"
        stroke-dasharray="7 5"
        stroke-linecap="round"
      ></circle>
      <circle cx="75" cy="75" r="50" fill="none" stroke="#6E1C18" stroke-width="3"></circle>
      <text
        x="75"
        y="92"
        text-anchor="middle"
        font-family="Young Serif"
        font-size="48"
        fill="#F6E3D8"
      >
        §
      </text>
    </svg>
  </div>
</div>

<style>
  /* Compact : texte à gauche, sceau à droite, comme sur la maquette « tout sur un écran ». */
  .acte {
    position: relative;
    display: flex;
    padding: 0.4375rem;
    background: #f7f9f3;
    box-shadow: 0 16px 28px rgb(60 30 5 / 0.35);
  }

  .pin {
    position: absolute;
    top: -8px;
    left: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #b9f6ca, #1e7a46 70%);
    box-shadow: 2px 3px 3px rgb(0 0 0 / 0.35);
  }

  .frame {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0.875rem;
    border: 4px double #1e4636;
    color: #1e4636;
  }

  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  p {
    margin: 0;
  }

  .republic {
    font-size: 0.625rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .title {
    font-family: "Young Serif", serif;
    font-size: 1.625rem;
    line-height: 1;
  }

  .terms {
    font-family: "Courier Prime", monospace;
    font-size: 0.75rem;
  }

  .line {
    display: block;
  }

  .seal {
    flex: none;
  }
</style>
