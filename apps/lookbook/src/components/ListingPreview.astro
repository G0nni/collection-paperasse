---
// Aperçu du Look 03 : le papier listing du SAV de ta vie, avec ses bandes à trous d'entraînement.
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";

type Props = { label: string };

const { label } = Astro.props;

/** Tickets du listing : intitulé, statut. Le premier est en critique. */
const ROWS: readonly {
  readonly ticket: string;
  readonly status: string;
  readonly critical?: true;
}[] = [
  { ticket: "#4021 Frigo vide", status: "Critique", critical: true },
  { ticket: "#4023 Rappeler mamie", status: "Rouvert ×3" },
  { ticket: "#4026 214 onglets", status: "Won't fix" },
  { ticket: "#4027 Tupperware", status: "Diplomatique" },
];
---

<div class="listing" role="img" aria-label={label}>
  <span class="tape" aria-hidden="true"></span>
  <span class="feed" aria-hidden="true"></span>
  <div class="sheet">
    <p class="brand">SAV de ta vie</p>
    {ROWS.map((row) => (
      <p class="row">
        <span>{row.ticket}</span>
        {row.critical ? <strong class="critical">{row.status}</strong> : <span>{row.status}</span>}
      </p>
    ))}
  </div>
  <span class="feed feed-right" aria-hidden="true"></span>
</div>

<style>
  .listing {
    position: relative;
    display: flex;
    background: #fcfbf5;
    box-shadow: 0 16px 28px rgb(60 30 5 / 0.35);
  }

  .tape {
    position: absolute;
    top: -8px;
    right: 22px;
    width: 80px;
    height: 22px;
    background: rgb(255 250 220 / 0.65);
    transform: rotate(-4deg);
  }

  /* Bandes Caroll : les trous laissent voir le liège. */
  .feed {
    flex: 0 0 20px;
    border-right: 1px dashed #bdb7aa;
    background: radial-gradient(circle, var(--cork) 4px, transparent 4.6px) center 10px / 20px 20px
      repeat-y;
  }

  .feed-right {
    border-right: 0;
    border-left: 1px dashed #bdb7aa;
  }

  .sheet {
    flex: 1;
    min-width: 0;
    color: #1c1b18;
    font-family: "Courier Prime", monospace;
    font-size: 0.75rem;
  }

  p {
    margin: 0;
  }

  .brand {
    padding: 0.625rem 0.625rem 0.375rem;
    font-family: "Alfa Slab One", serif;
    font-size: 0.9375rem;
    text-transform: uppercase;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.5rem;
    padding: 0.3125rem 0.625rem;
  }

  .row:nth-child(even) {
    background: #ddebd8;
  }

  .row:last-child {
    padding-bottom: 0.5rem;
  }

  /* Si la ligne se replie, le statut reste calé à droite comme sur le listing. */
  .row > :last-child {
    margin-left: auto;
  }

  .critical {
    color: #b42318;
    text-transform: uppercase;
  }
</style>
