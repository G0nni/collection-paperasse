---
// Aperçu du Look 01 : le ticket de caisse du Réunion-mètre, scotché sur le liège.
import "@fontsource/doto/900.css";

type Props = { label: string };

const { label } = Astro.props;

const NBSP = String.fromCodePoint(0xa0);

/** Lignes du ticket : poste facturé, montant. */
const LINES: readonly (readonly [string, string])[] = [
  ["Tour de table", "79,30"],
  [`«${NBSP}Tu m'entends${NBSP}?${NBSP}»`, "34,69"],
  ["Décisions prises", "0"],
];
---

<div class="ticket" role="img" aria-label={label}>
  <span class="tape" aria-hidden="true"></span>
  <div class="display">
    <span class="currency">€</span>
    <span class="amount">247,80</span>
  </div>
  <div class="lines">
    <p class="heading">*** Ticket de réunion ***</p>
    {LINES.map(([item, amount]) => (
      <p class="line">
        <span>{item}</span>
        <span>{amount}</span>
      </p>
    ))}
  </div>
</div>

<style>
  .ticket {
    position: relative;
    padding-bottom: 1.125rem;
    background: #fafaf7;
    color: #1a1714;
    box-shadow: 0 16px 28px rgb(60 30 5 / 0.35);
  }

  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 96px;
    height: 26px;
    margin-left: -48px;
    background: rgb(255 250 220 / 0.65);
    transform: rotate(3deg);
  }

  .display {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 1.125rem 1rem;
    background: #16120e;
    color: #ffb000;
    font-family: Doto, monospace;
    font-weight: 900;
  }

  .currency {
    font-size: 1.125rem;
  }

  .amount {
    font-size: 3.375rem;
    line-height: 1;
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1.125rem 0;
    font-size: 0.8125rem;
  }

  p {
    margin: 0;
  }

  .heading {
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
</style>
