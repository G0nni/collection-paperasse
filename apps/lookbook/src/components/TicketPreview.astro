---
// Aperçu du Look 01 : le ticket de caisse du Réunion-mètre, scotché sur le liège.
import "@fontsource/doto/900.css";
import { NBSP } from "@paperasse/shared/typography";

type Props = { label: string };

const { label } = Astro.props;

/** Lignes du ticket : poste facturé, montant. */
const LINES: readonly (readonly [string, string])[] = [
  ["Tour de table", "79,30"],
  [`«${NBSP}Tu m'entends${NBSP}?${NBSP}»`, "34,69"],
  ["Décisions prises", "0"],
];
---

<div class="ticket" role="img" aria-label={label}>
  <span class="tape" aria-hidden="true"></span>
  <div class="display">
    <span class="currency">€</span>
    <span class="amount">247,80</span>
  </div>
  <div class="lines">
    <p class="heading">*** Ticket de réunion ***</p>
    {LINES.map(([item, amount]) => (
      <p class="line">
        <span>{item}</span>
        <span>{amount}</span>
      </p>
    ))}
  </div>
</div>

<style>
  /* Compact (specs/lookbook.md, Disposition) : c'est l'aperçu qu'on réduit, pas la fiche. */
  .ticket {
    position: relative;
    padding-bottom: 0.75rem;
    background: #fafaf7;
    color: #1a1714;
    box-shadow: 0 16px 28px rgb(60 30 5 / 0.35);
  }

  .tape {
    position: absolute;
    top: -8px;
    left: 50%;
    width: 80px;
    height: 22px;
    margin-left: -40px;
    background: rgb(255 250 220 / 0.65);
    transform: rotate(3deg);
  }

  .display {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: #16120e;
    color: #ffb000;
    font-family: Doto, monospace;
    font-weight: 900;
  }

  .currency {
    font-size: 0.9375rem;
  }

  .amount {
    font-size: 2.5rem;
    line-height: 1;
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.625rem 1rem 0;
    font-size: 0.75rem;
  }

  p {
    margin: 0;
  }

  .heading {
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
</style>
