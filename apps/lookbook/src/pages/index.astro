---
// Lookbook de la Collection Paperasse : le tableau d'affichage de la mairie (specs/lookbook.md).
// Pas de CollectionTag ici : le lookbook est la racine vers laquelle les étiquettes renvoient.
import "@fontsource/alfa-slab-one/400.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import { REPO_URL } from "@paperasse/shared/config";
import { NBSP } from "@paperasse/shared/typography";
import ActePreview from "../components/ActePreview.astro";
import ListingPreview from "../components/ListingPreview.astro";
import TicketPreview from "../components/TicketPreview.astro";
import { buildCatalog, type PreviewKind } from "../lib/catalog";
import { PAGE_TEXT } from "../lib/page-text";

/** Le document punaisé au-dessus de chaque fiche, selon le look. */
const PREVIEWS: Readonly<Record<PreviewKind, typeof TicketPreview>> = {
  ticket: TicketPreview,
  acte: ActePreview,
  listing: ListingPreview,
};

const catalog = buildCatalog().map((card) => ({ ...card, Preview: PREVIEWS[card.preview] }));
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PAGE_TEXT.title}</title>
    <meta name="description" content={PAGE_TEXT.description} />
  </head>
  <body>
    <div class="board">
      <header class="poster">
        <span class="pin pin-red" aria-hidden="true"></span>
        <span class="pin pin-blue" aria-hidden="true"></span>
        <p class="kicker">{PAGE_TEXT.posterKicker}</p>
        <span class="rule" aria-hidden="true"></span>
        <h1>{PAGE_TEXT.posterTitle}</h1>
        <p class="season">{`${PAGE_TEXT.season} ${PAGE_TEXT.rule}`}</p>
        <span class="stamp" aria-hidden="true">
          {PAGE_TEXT.stamp}
        </span>
      </header>

      <main class="catalog">
        <h2 class="visually-hidden">{PAGE_TEXT.looksHeading}</h2>
        {/* role="list" : Safari retire la sémantique de liste quand les puces sont masquées. */}
        <ol class="looks" role="list">
          {catalog.map(({ Preview, ...card }) => (
            <li class="look">
              <article aria-labelledby={`${card.slug}-title`}>
                <div class:list={["preview", `preview-${card.preview}`]}>
                  <Preview label={card.previewLabel} />
                </div>
                <div class="label">
                  <span class="hole" aria-hidden="true" />
                  {/* Numéro et nom sur la même ligne (spec, Design), repliés si la place manque. */}
                  <div class="label-head">
                    <p class="number">{card.label}</p>
                    <h3 id={`${card.slug}-title`}>{card.name}</h3>
                  </div>
                  <p class="tagline">{card.tagline}</p>
                  <dl class="sheet">
                    {card.sheet.map((entry) => (
                      <>
                        <dt>{entry.term}</dt>
                        <dd>{entry.value}</dd>
                      </>
                    ))}
                  </dl>
                  <a class="try" href={card.href} aria-label={card.linkLabel}>
                    <span>
                      {card.linkText}
                      <span aria-hidden="true">{NBSP}→</span>
                    </span>
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </main>

      {/* Après les looks dans le HTML (lecture et tabulation, CA-7), même si ≥ 1000 px les
          post-its s'affichent de part et d'autre de l'affiche. */}
      <footer class="notes">
        <div class="note note-yellow">
          <p>
            <strong>{PAGE_TEXT.nextCollection}</strong>{" "}
            <span class="note-line">{PAGE_TEXT.nextCollectionDetail}</span>
          </p>
        </div>
        <div class="note note-blue">
          <p>
            {PAGE_TEXT.privacy.map((line, index) => (
              <>
                {index > 0 && " "}
                <span class="note-line">{line}</span>
              </>
            ))}
          </p>
          <a class="repo" href={REPO_URL}>
            <span>
              {PAGE_TEXT.repoLink}
              <span aria-hidden="true">{NBSP}→</span>
            </span>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* Tokens de specs/lookbook.md (« Design »). */
  :root {
    --cork: #c38f55;
    --poster: #ffe45c;
    --ink: #1b1b1b;
    --stamp-red: #b3261e;
    --kraft: #ead3a2;
    --look-number: #c2410c;
    --postit-blue: #a7e0f2;
    --shadow: 60 30 5;
  }

  html {
    background: var(--cork);
  }

  body {
    margin: 0;
    color: var(--ink);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    /* Liège : deux semis de points superposés, l'un sombre, l'autre clair. */
    background:
      radial-gradient(circle at 20% 30%, rgb(90 50 15 / 0.35) 0 1.2px, transparent 1.6px) 0 0 / 9px
        11px,
      radial-gradient(circle at 70% 60%, rgb(255 235 200 / 0.28) 0 1px, transparent 1.5px) 0 0 /
        13px 7px,
      var(--cork);
  }
</style>

<style>
  /* Disposition (specs/lookbook.md, « Disposition ») : une colonne sous 640 px, deux de 640 à
     999 px, puis à partir de 1000 px les post-its encadrent l'affiche et les trois looks sont
     côte à côte. Les seuils sont ceux de la maquette « tout sur un écran (1280×720) ». */
  .board {
    --board-gap-x: 20px;
    --board-pad-x: clamp(1rem, 2.5vw, 1.5rem);

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "poster"
      "looks"
      "notes";
    gap: 2.25rem var(--board-gap-x);
    align-content: center;
    box-sizing: border-box;
    width: 100%;
    max-width: calc(1180px + 2 * var(--board-pad-x));
    min-height: 100vh;
    min-height: 100svh;
    margin: 0 auto;
    padding: 1.25rem var(--board-pad-x) 2rem;
    /* Les documents inclinés débordent de quelques pixels : on rogne sans créer de défilement. */
    overflow-x: clip;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Affiche « Avis à la population » : un bandeau compact (environ 160 px à 1280 px). */

  .poster {
    grid-area: poster;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-sizing: border-box;
    width: 100%;
    /* Marge basse : le tampon s'y loge sans mordre sur la dernière ligne de texte. */
    padding: 1rem clamp(1rem, 3vw, 1.75rem) 1.75rem;
    background: var(--poster);
    text-align: center;
    transform: rotate(-0.8deg);
    /* Le titre se cale sur la largeur de l'affiche (unités cqi), pas sur celle de la fenêtre :
       il reste dedans même avec une police du navigateur agrandie. */
    container-type: inline-size;
    box-shadow:
      0 2px 0 rgb(0 0 0 / 0.08),
      0 18px 32px rgb(var(--shadow) / 0.35);
  }

  .pin {
    position: absolute;
    top: 10px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: 2px 3px 3px rgb(0 0 0 / 0.35);
  }

  .pin-red {
    left: 14px;
    background: radial-gradient(circle at 35% 30%, #ff8a80, var(--stamp-red) 70%);
  }

  .pin-blue {
    right: 14px;
    background: radial-gradient(circle at 35% 30%, #82b1ff, #1f4fb8 70%);
  }

  .poster p {
    margin: 0;
  }

  .kicker {
    /* Laisse la place aux punaises sur les petits écrans. */
    padding-inline: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .rule {
    display: block;
    height: 3px;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  /* Sous 1000 px le titre peut passer sur deux lignes ; 18cqi borne le mot le plus long
     (« Collection », environ 5,3 fois le corps) à la largeur de l'affiche quand la police du
     navigateur est agrandie. Sans effet à la police par défaut. */
  h1 {
    margin: 0;
    font-family: "Alfa Slab One", serif;
    font-size: min(clamp(2.125rem, 4.4vw, 3.5rem), 18cqi);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* 13 px : saison et règle tiennent sur une ligne dans le bandeau à 1280 px. */
  .season {
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .stamp {
    position: absolute;
    right: clamp(8px, 2vw, 22px);
    bottom: -20px;
    padding: 4px 10px;
    border: 3px solid var(--stamp-red);
    border-radius: 6px;
    background: rgb(255 255 255 / 0.35);
    color: var(--stamp-red);
    font-family: "Alfa Slab One", serif;
    font-size: 1rem;
    text-transform: uppercase;
    transform: rotate(-10deg);
  }

  /* Les trois looks */

  .catalog {
    grid-area: looks;
    min-width: 0;
  }

  .looks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.25rem 1.75rem;
    align-items: start;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Seuls les aperçus sont de travers : la fiche et le lien restent droits pour la lecture.
     Hauteur minimale = hauteur réelle du plus grand aperçu, le ticket (158 px à la police par
     défaut, contre 152 pour l'acte et le listing) : les trois étiquettes démarrent à la même
     hauteur quand les looks sont côte à côte. */
  .preview {
    display: grid;
    min-height: 9.875rem;
    transform: rotate(var(--tilt, 0deg));
  }

  .preview-ticket {
    --tilt: -2deg;
  }

  .preview-acte {
    --tilt: 1.5deg;
  }

  .preview-listing {
    --tilt: -1deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .preview {
      transition: transform 200ms ease-out;
    }

    .look:hover .preview,
    .look:focus-within .preview {
      transform: rotate(0deg) translateY(-4px);
    }
  }

  /* Étiquette kraft trouée : la fiche défilé */

  .label {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem 1rem 1rem 2.375rem;
    border-radius: 6px;
    background: var(--kraft);
    box-shadow: 0 6px 14px rgb(var(--shadow) / 0.25);
  }

  .hole {
    position: absolute;
    top: 20px;
    left: 14px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--cork);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.4);
  }

  .label p,
  .label h3 {
    margin: 0;
  }

  .label-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75rem;
  }

  /* Orange des numéros réservé au gros corps (≥ 24 px) : 3,54:1 sur le kraft, seuil 3:1. */
  .number {
    color: var(--look-number);
    font-family: "Alfa Slab One", serif;
    font-size: 1.625rem;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  h3 {
    font-family: "Alfa Slab One", serif;
    font-size: 1.3125rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .tagline {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .sheet {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.1875rem 0.75rem;
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ink);
    font-size: 0.8125rem;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  a {
    color: var(--ink);
  }

  a:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .try {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    margin-top: 0.25rem;
    padding: 0 1rem;
    background: var(--ink);
    color: var(--poster);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .try:hover {
    background: var(--stamp-red);
    text-decoration: underline;
  }

  /* Post-its : inclinés et en Courier Prime, comme sur la maquette. */

  .notes {
    grid-area: notes;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    align-items: start;
    gap: 1.75rem var(--board-gap-x);
  }

  .note {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-sizing: border-box;
    width: min(100%, 240px);
    min-height: 124px;
    padding: 0.875rem 1rem;
    box-shadow: 0 10px 18px rgb(var(--shadow) / 0.3);
    font-family: "Courier Prime", monospace;
    font-size: 0.9375rem;
    line-height: 1.3;
    transform: rotate(var(--tilt, 0deg));
  }

  .note p {
    margin: 0;
  }

  .note-line {
    display: block;
  }

  .note-yellow {
    --tilt: -3deg;
    background: var(--poster);
  }

  .note-blue {
    --tilt: 2.5deg;
    background: var(--postit-blue);
  }

  .repo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: auto;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  /* Le survol épaissit le soulignement en plus de changer la couleur (CLAUDE.md : jamais la
     couleur seule pour distinguer deux états). */
  .repo:hover {
    color: var(--stamp-red);
    text-decoration-thickness: 3px;
  }

  /* 640 à 999 px : looks sur deux colonnes (le 3e seul sur la ligne suivante), post-its côte à
     côte sous les looks. */
  @media (min-width: 640px) {
    .looks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }

    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* À partir de 1000 px : l'affiche devient un bandeau centré entre les deux post-its, titre
     sur une ligne, et les trois looks tiennent sous elle, sans défilement à 1280×720 (CA-6). */
  @media (min-width: 1000px) {
    .board {
      /* Pistes partagées avec .notes : mêmes colonnes, même column-gap, donc post-its alignés
         sur les colonnes de part et d'autre de l'affiche. */
      --board-columns: 190px minmax(0, 1fr) 190px;

      grid-template-columns: var(--board-columns);
      grid-template-areas:
        ". poster ."
        "looks looks looks";
      row-gap: 26px;
      align-items: center;
      padding-block: 20px;
    }

    .poster {
      justify-self: center;
      max-width: 760px;
    }

    /* Une seule ligne, donc une taille bornée par la largeur de l'affiche : 9cqi laisse une
       marge à « Collection Paperasse » (environ 10,8 fois le corps en Alfa Slab One), que la
       police racine soit à 16 ou à 24 px. */
    h1 {
      font-size: min(3.5rem, 9cqi);
      white-space: nowrap;
    }

    .looks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Le pied de page occupe toute la première ligne et reprend les pistes de .board : jaune à
       gauche de l'affiche, bleu à droite. Sa colonne du milieu reste vide ; l'affiche,
       positionnée, est peinte au-dessus. */
    .notes {
      grid-row: 1;
      grid-column: 1 / -1;
      grid-template-columns: var(--board-columns);
      column-gap: var(--board-gap-x);
      align-items: center;
    }

    .note {
      width: 100%;
    }

    .note-yellow {
      grid-column: 1;
    }

    .note-blue {
      grid-column: 3;
    }
  }
</style>
