---
// Lookbook de la Collection Paperasse : le tableau d'affichage de la mairie (specs/lookbook.md).
// Pas de CollectionTag ici : le lookbook est la racine vers laquelle les étiquettes renvoient.
import "@fontsource/alfa-slab-one/400.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "@fontsource/courier-prime/400.css";
import "@fontsource/courier-prime/700.css";
import { REPO_URL } from "@paperasse/shared/config";
import ActePreview from "../components/ActePreview.astro";
import ListingPreview from "../components/ListingPreview.astro";
import TicketPreview from "../components/TicketPreview.astro";
import { buildCatalog, PAGE_TEXT } from "../lib/catalog";

const catalog = buildCatalog();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PAGE_TEXT.title}</title>
    <meta name="description" content={PAGE_TEXT.description} />
  </head>
  <body>
    <div class="board">
      <header class="poster">
        <span class="pin pin-red" aria-hidden="true"></span>
        <span class="pin pin-blue" aria-hidden="true"></span>
        <p class="kicker">{PAGE_TEXT.posterKicker}</p>
        <span class="rule" aria-hidden="true"></span>
        <h1>
          {PAGE_TEXT.posterTitle.map((word, index) => (
            <>
              {index > 0 && " "}
              <span class="title-line">{word}</span>
            </>
          ))}
        </h1>
        <p class="season">
          <span class="season-line">{PAGE_TEXT.season}</span>{" "}
          <span class="season-line">{PAGE_TEXT.rule}</span>
        </p>
        <span class="stamp" aria-hidden="true">
          {PAGE_TEXT.stamp}
        </span>
      </header>

      <main>
        <h2 class="visually-hidden">{PAGE_TEXT.looksHeading}</h2>
        <ol class="looks">
          {catalog.map((card) => (
            <li class="look">
              <article aria-labelledby={`${card.slug}-title`}>
                <div class:list={["preview", `preview-${card.preview}`]}>
                  {card.preview === "ticket" && <TicketPreview label={card.previewLabel} />}
                  {card.preview === "acte" && <ActePreview label={card.previewLabel} />}
                  {card.preview === "listing" && <ListingPreview label={card.previewLabel} />}
                </div>
                <div class="label">
                  <span class="hole" aria-hidden="true" />
                  <p class="number">{card.label}</p>
                  <h3 id={`${card.slug}-title`}>{card.name}</h3>
                  <p class="tagline">{card.tagline}</p>
                  <dl class="sheet">
                    {card.sheet.map((entry) => (
                      <>
                        <dt>{entry.term}</dt>
                        <dd>{entry.value}</dd>
                      </>
                    ))}
                  </dl>
                  <a class="try" href={card.href} aria-label={card.linkLabel}>
                    <span>
                      {card.linkText}
                      <span aria-hidden="true">&nbsp;→</span>
                    </span>
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </main>

      <footer class="notes">
        <div class="note note-yellow">
          <p>
            <strong>{PAGE_TEXT.nextCollection}</strong>{" "}
            <span class="note-line">{PAGE_TEXT.nextCollectionDetail}</span>
          </p>
        </div>
        <div class="note note-blue">
          <p>
            {PAGE_TEXT.privacy.map((line, index) => (
              <>
                {index > 0 && " "}
                <span class="note-line">{line}</span>
              </>
            ))}
          </p>
          <a class="repo" href={REPO_URL}>
            <span>
              {PAGE_TEXT.repoLink}
              <span aria-hidden="true">&nbsp;→</span>
            </span>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  html {
    background: #c38f55;
  }

  body {
    margin: 0;
    color: #1b1b1b;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    /* Liège : deux semis de points superposés, l'un sombre, l'autre clair. */
    background:
      radial-gradient(circle at 20% 30%, rgb(90 50 15 / 0.35) 0 1.2px, transparent 1.6px) 0 0 / 9px
        11px,
      radial-gradient(circle at 70% 60%, rgb(255 235 200 / 0.28) 0 1px, transparent 1.5px) 0 0 /
        13px 7px,
      #c38f55;
  }
</style>

<style>
  .board {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem clamp(1rem, 2.5vw, 2.5rem) 4rem;
    /* Les documents inclinés débordent de quelques pixels : on rogne sans créer de défilement. */
    overflow-x: clip;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Affiche « Avis à la population » */

  .poster {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-self: center;
    box-sizing: border-box;
    width: min(100%, 860px);
    padding: clamp(28px, 5vw, 56px) clamp(20px, 5vw, 64px) 36px;
    background: #ffe45c;
    text-align: center;
    transform: rotate(-1deg);
    box-shadow:
      0 2px 0 rgb(0 0 0 / 0.08),
      0 22px 40px rgb(60 30 5 / 0.35);
  }

  .pin {
    position: absolute;
    top: 14px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    box-shadow: 2px 3px 3px rgb(0 0 0 / 0.35);
  }

  .pin-red {
    left: 22px;
    background: radial-gradient(circle at 35% 30%, #ff8a80, #b3261e 70%);
  }

  .pin-blue {
    right: 22px;
    background: radial-gradient(circle at 35% 30%, #82b1ff, #1f4fb8 70%);
  }

  .poster p {
    margin: 0;
  }

  .kicker {
    /* Laisse la place aux punaises sur les petits écrans. */
    padding-inline: 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .rule {
    display: block;
    height: 4px;
    border-top: 2px solid #1b1b1b;
    border-bottom: 1px solid #1b1b1b;
  }

  h1 {
    margin: 0;
    font-family: "Alfa Slab One", serif;
    font-size: clamp(2.75rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .title-line,
  .season-line,
  .note-line {
    display: block;
  }

  .season {
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .stamp {
    position: absolute;
    right: clamp(8px, 4vw, 40px);
    bottom: -22px;
    padding: 6px 14px;
    border: 3px solid #b3261e;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.35);
    color: #b3261e;
    font-family: "Alfa Slab One", serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    transform: rotate(-12deg);
  }

  /* Les trois looks */

  .looks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 1.75rem;
    align-items: start;
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 960px) {
    .looks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }

  /* Seuls les aperçus sont de travers : la fiche et le lien restent droits pour la lecture. */
  .preview {
    transform: rotate(var(--tilt, 0deg));
  }

  .preview-ticket {
    --tilt: -2.5deg;
  }

  .preview-acte {
    --tilt: 1.8deg;
  }

  .preview-listing {
    --tilt: -1.2deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .preview {
      transition: transform 200ms ease-out;
    }

    .look:hover .preview,
    .look:focus-within .preview {
      transform: rotate(0deg) translateY(-4px);
    }
  }

  /* Étiquette kraft trouée : la fiche défilé */

  .label {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.125rem 1.25rem 1.25rem 2.75rem;
    border-radius: 6px;
    background: #ead3a2;
    box-shadow: 0 6px 14px rgb(60 30 5 / 0.25);
  }

  .hole {
    position: absolute;
    top: 22px;
    left: 16px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #c38f55;
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.4);
  }

  .label p,
  .label h3 {
    margin: 0;
  }

  /* Orange des numéros réservé au très grand corps (≥ 34 px) : contraste 3:1 sur le kraft. */
  .number {
    color: #c2410c;
    font-family: "Alfa Slab One", serif;
    font-size: 2.125rem;
    line-height: 1;
    text-transform: uppercase;
  }

  h3 {
    font-family: "Alfa Slab One", serif;
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .tagline {
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .sheet {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding-top: 0.625rem;
    border-top: 1px solid #1b1b1b;
    font-size: 0.8125rem;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  a {
    color: #1b1b1b;
  }

  a:focus-visible {
    outline: 3px solid #1b1b1b;
    outline-offset: 3px;
  }

  .try {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    padding: 0 1.125rem;
    background: #1b1b1b;
    color: #ffe45c;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .try:hover {
    background: #b3261e;
    text-decoration: underline;
  }

  /* Post-its du pied de page */

  .notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .note {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-sizing: border-box;
    width: 220px;
    min-height: 160px;
    padding: 1.25rem;
    box-shadow: 0 10px 18px rgb(60 30 5 / 0.3);
    font-family: "Courier Prime", monospace;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .note p {
    margin: 0;
  }

  .note-yellow {
    background: #ffe45c;
  }

  .note-blue {
    background: #a7e0f2;
  }

  .repo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: auto;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .repo:hover {
    color: #b3261e;
  }
</style>
