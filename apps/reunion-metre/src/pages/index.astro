---
// Look 01 · Réunion-mètre (specs/reunion-metre.md). Une seule page, trois écrans
// (Configuration, Compteur, Ticket) choisis par le script d'après le lien. Le HTML livré est
// l'écran Configuration vierge ; tout texte venant du lien est écrit par le script, en
// textContent.
import "@fontsource/doto/900.css";
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import CollectionTag from "@paperasse/shared/CollectionTag.astro";
import { NBSP } from "@paperasse/shared/typography";
import { LIMITS, ROLES, SETUP_DEFAULT_TARIFF, TARIFFS, TARIFF_CODES } from "../lib/meeting";
import { TEXT, rateText } from "../lib/messages";

const tariffs = TARIFF_CODES.map((code) => TARIFFS[code]);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TEXT.pageTitle}</title>
    <meta name="description" content={TEXT.description} />
  </head>
  <body>
    <main id="app" data-screen="setup">
      {/* Bloc sans gap : une région live vide n'y occupe aucune place, et reste dans l'arbre
          d'accessibilité pour que ses messages soient annoncés. */}
      <div class="top">
        <header class="masthead">
          <div class="brand">
            <h1>{TEXT.heading}</h1>
            <p class="subtitle free-text" id="subtitle">
              {TEXT.tagline}
            </p>
          </div>
          <div class="actions">
            <button type="button" class="ghost-button" id="copy-meter" hidden>
              {TEXT.copyMeter}
            </button>
            <button type="button" class="ghost-button" id="copy-ticket" hidden>
              {TEXT.copyTicket}
            </button>
            {/* Confirmation de copie, à côté du bouton (spec, « Écrans ») : jamais par-dessus le
                ticket. Sa place est réservée, vide ou pleine : les boutons ne bougent pas quand
                elle apparaît. */}
            <p class="copy-status" id="copy-status" aria-live="polite"></p>
            {/* Enseigne de taxi : OCCUPÉ pendant le Compteur (bouton Terminer). */}
            <button type="button" class="sign sign-busy" id="finish" hidden>
              <span class="sign-lamp" aria-hidden="true">
                {TEXT.busyLamp}
              </span>
              <span class="sign-action">{TEXT.finish}</span>
            </button>
            <button type="button" class="sign sign-free" id="new-meeting" hidden>
              <span class="sign-lamp" aria-hidden="true">
                {TEXT.freeLamp}
              </span>
              <span class="sign-action">{TEXT.newMeeting}</span>
            </button>
          </div>
        </header>
        {/* Messages du lien. Sur le Compteur en grand écran, cette pile flotte sous le ticket :
            elle ne prend jamais de hauteur à la liste (CA-11), et « Fermer » la retire. */}
        <div class="feedback">
          <div class="notices">
            <div class="notices-text" role="status">
              <ul class="messages" id="notices"></ul>
            </div>
            <button type="button" class="dismiss" id="dismiss-notices" hidden>
              {TEXT.dismiss}
              <span class="visually-hidden">{` ${TEXT.dismissContext}`}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="layout">
        <div class="panel">
          <section class="board" id="board" aria-labelledby="amount-heading" hidden>
            <h2 class="label" id="amount-heading">
              {TEXT.amountHeading}
            </h2>
            <div class="board-main">
              <div class="led">
                {/* Le résumé accessible est dans aria-label (au plus toutes les 30 s, CA-8) :
                  les chiffres qui changent chaque seconde sont masqués aux lecteurs d'écran. */}
                <div
                  class="led-readout"
                  id="timer"
                  role="timer"
                  aria-live="off"
                  aria-label="0 euro"
                >
                  <span class="led-currency" aria-hidden="true">
                    €
                  </span>
                  <span class="led-digits" id="amount" aria-hidden="true" data-ghost="8,88">
                    0,00
                  </span>
                </div>
                {/* Alertes CL-2 et CL-6 sur la ligne de l'afficheur, comme le voyant d'un
                    taximètre : elles ne poussent pas la liste des participants. */}
                <div class="led-status" role="status">
                  <ul class="alerts" id="alerts"></ul>
                </div>
              </div>
              <dl class="stats">
                <div class="stat">
                  <dt>{TEXT.durationLabel}</dt>
                  <dd id="clock">00:00:00</dd>
                </div>
                <div class="stat">
                  <dt>{TEXT.countLabel}</dt>
                  <dd id="count">00</dd>
                </div>
                <div class="stat">
                  <dt>{TEXT.hourlyLabel}</dt>
                  <dd id="hourly">0</dd>
                </div>
              </dl>
            </div>
            <p class="ended ticket-only">{TEXT.ended}</p>
          </section>

          <form class="controls" id="controls" novalidate>
            <h2 class="label setup-only" id="setup-heading" tabindex="-1">
              {TEXT.setupHeading}
            </h2>
            <p class="field setup-only">
              <label for="title">{TEXT.titleLabel}</label>
              <input
                id="title"
                type="text"
                autocomplete="off"
                placeholder={TEXT.titlePlaceholder}
                aria-describedby="title-error"
              />
              <span class="error" id="title-error"></span>
            </p>

            <fieldset class="tariffs">
              <legend class="label">{TEXT.tariffLegend}</legend>
              <div class="tariff-options">
                {tariffs.map((tariff) => (
                  <label class="tariff">
                    <input
                      class="tariff-input"
                      type="radio"
                      name="tariff"
                      value={tariff.code}
                      checked={tariff.code === SETUP_DEFAULT_TARIFF}
                    />
                    <span class="tariff-code">{tariff.code}</span>
                    <span class="tariff-name">{tariff.name}</span>
                    <span class="tariff-factor">{tariff.factor}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            {/* Bloc sans gap : l'erreur vide n'y prend aucune place mais reste dans l'arbre
                d'accessibilité, pour que la région live annonce ce qui s'y écrit. */}
            <div class="people-block">
              <fieldset class="people">
                <legend class="label">{TEXT.peopleLegend}</legend>
                <ol class="people-list" id="people" role="list"></ol>
                <p class="people-footer">
                  <button type="button" class="add-person" id="add-person">
                    {TEXT.addPerson}
                  </button>
                  <span class="people-full" id="people-full" hidden>
                    {TEXT.peopleFull}
                  </span>
                </p>
              </fieldset>

              {/* Hors du bloc de lancement : visible aussi pendant le Compteur. */}
              <p class="error form-error" id="form-error" aria-live="polite"></p>
            </div>

            <div class="launch setup-only">
              <p class="hourly-preview">
                {`${TEXT.hourlyPreview}${NBSP}: `}
                <strong id="hourly-preview">{`0${NBSP}€`}</strong>
              </p>
              {/* Enseigne de taxi : LIBRE avant la réunion (bouton Lancer). */}
              <button type="submit" class="sign sign-free" id="launch">
                <span class="sign-lamp" aria-hidden="true">
                  {TEXT.freeLamp}
                </span>
                <span class="sign-action">{TEXT.launch}</span>
              </button>
            </div>
          </form>
        </div>

        <aside class="receipt" id="receipt" aria-labelledby="receipt-heading" hidden>
          <div class="paper">
            <h2 class="receipt-heading" id="receipt-heading">
              <span aria-hidden="true">***</span>
              {TEXT.receiptHeading}
              <span aria-hidden="true">***</span>
            </h2>
            <p class="receipt-title free-text" id="receipt-title" hidden></p>
            <p class="receipt-meta" id="receipt-when"></p>
            <p class="receipt-meta">{`${TEXT.deviceTime} · ${TEXT.receiptCounter}`}</p>
            <hr />
            <div class="ticket-only">
              <dl class="receipt-lines">
                <div class="receipt-line">
                  <dt>{TEXT.receiptDuration}</dt>
                  <dd id="receipt-duration">00:00:00</dd>
                </div>
              </dl>
              <p class="receipt-section">{TEXT.receiptPeople}</p>
              <dl class="receipt-lines" id="receipt-people"></dl>
              <hr />
            </div>
            <dl class="receipt-lines" id="receipt-lines"></dl>
            <hr />
            <dl class="receipt-lines">
              <div class="receipt-line receipt-total">
                <dt>{TEXT.total}</dt>
                <dd id="receipt-total">0,00 €</dd>
              </div>
              <div class="receipt-line receipt-small">
                <dt>{TEXT.decisions}</dt>
                <dd>{TEXT.decisionsValue}</dd>
              </div>
              <div class="receipt-line receipt-small">
                <dt>{TEXT.mail}</dt>
                <dd id="receipt-mail">PEUT-ÊTRE</dd>
              </div>
            </dl>
            <div class="barcode" aria-hidden="true"></div>
            <p class="receipt-thanks">{TEXT.receiptThanks}</p>
          </div>
          <div class="tear" aria-hidden="true"></div>
        </aside>
      </div>

      <noscript>
        <p class="message">{TEXT.noScript}</p>
      </noscript>
    </main>

    {/* Repli de copie (CA-7) : modal, Échap ou « Fermer » le referment, le focus revient au
        bouton de copie (scripts/copy.ts). */}
    <dialog
      class="copy-dialog"
      id="copy-dialog"
      aria-labelledby="copy-dialog-title"
      aria-describedby="copy-dialog-text"
    >
      <h2 class="copy-dialog-title" id="copy-dialog-title">
        {TEXT.copyDialogTitle}
      </h2>
      <p class="copy-dialog-text" id="copy-dialog-text">
        {TEXT.copyRefused}
      </p>
      <p class="copy-dialog-field">
        <label for="copy-field">{TEXT.linkField}</label>
        <input id="copy-field" type="text" readonly spellcheck="false" autocomplete="off" />
      </p>
      <form class="copy-dialog-actions" method="dialog">
        <button type="submit" class="ghost-button">
          {TEXT.dismiss}
        </button>
      </form>
    </dialog>

    <CollectionTag slug="reunion-metre" />

    <datalist id="roles">
      {ROLES.map((role) => (
        <option value={role.label} label={rateText(role.rate)} />
      ))}
    </datalist>

    {/* Une ligne participant, clonée par le script (pas d'innerHTML). */}
    <template id="person-template">
      <li class="person">
        <fieldset class="person-fields">
          <legend class="visually-hidden" data-slot="legend"></legend>
          <span class="person-who">
            <label class="person-label" data-slot="who-label">
              {TEXT.whoLabel}
            </label>
            <input
              class="person-input"
              data-slot="who"
              type="text"
              list="roles"
              autocomplete="off"
              spellcheck="false"
            />
          </span>
          <span class="person-rate">
            <label class="person-label" data-slot="rate-label">
              {TEXT.rateLabel}
            </label>
            <span class="rate-box">
              <input
                class="person-input rate-input"
                data-slot="rate"
                type="number"
                inputmode="numeric"
                min={LIMITS.minRate}
                max={LIMITS.maxRate}
                step="1"
              />
              <span class="rate-unit" aria-hidden="true">
                €/h
              </span>
            </span>
          </span>
          <button type="button" class="remove" data-slot="remove">
            {TEXT.remove}
            <span class="visually-hidden" data-slot="remove-context"></span>
          </button>
          <span class="error person-error" data-slot="error"></span>
        </fieldset>
      </li>
    </template>
  </body>
</html>

<script>
  import "../scripts/app";
</script>

<style is:global>
  /* Tokens de specs/reunion-metre.md (« Design »). */
  :root {
    --bg: #16120e;
    --panel: #211b15;
    --led: #0b0907;
    --amber: #ffb000;
    --ghost: rgb(255 176 0 / 0.09);
    --text: #f3e9d6;
    --muted: #a8977a;
    --paper: #fafaf7;
    --ink: #1a1714;
    --chip: #2e261d;
    --line: #3a2f24;
    --glow: 0 0 18px rgb(255 176 0 / 0.45);
    --font-label: "Archivo Variable", "Archivo", system-ui, sans-serif;
    --font-digits: "Doto", ui-monospace, monospace;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    /* Étiquette de collection sur fond sombre. */
    --tag-bg: var(--panel);
    --tag-fg: var(--text);
    color-scheme: dark;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-label);
    font-stretch: 80%;
    line-height: 1.35;
  }

  /* `hidden` gagne toujours sur les display posés par les styles du look. */
  [hidden] {
    display: none !important;
  }

  /* Masqué à l'écran, lu par les lecteurs d'écran. Les <label> des lignes participant restent
     ainsi sur chaque ligne : la première sert d'en-tête de colonnes, et le Compteur les remplace
     par l'unité « €/h ». */
  .visually-hidden,
  .person:not(:first-child) .person-label,
  main[data-screen="meter"] .person-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  button,
  input {
    font: inherit;
    font-stretch: inherit;
  }

  button {
    cursor: pointer;
  }

  :focus-visible {
    outline: 3px solid var(--amber);
    outline-offset: 2px;
  }
</style>

<style>
  main {
    box-sizing: border-box;
    max-width: 82rem;
    margin: 0 auto;
    padding: 1rem 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* ---------- En-tête ---------- */

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.875rem;
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .subtitle {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Textes libres venant du lien (titre, libellés) : ce qui déborde est coupé, pour qu'un texte
     « zalgo » ou sans espace ne recouvre ni un montant ni une ligne voisine, et n'élargisse pas
     la page (CLAUDE.md, Sécurité). La petite marge laisse respirer les accents légitimes. */
  .free-text,
  .receipt-lines :global(dt) {
    min-width: 0;
    overflow-wrap: anywhere;
    overflow: clip;
    overflow-clip-margin: 0.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }

  .ghost-button {
    min-height: 48px;
    padding: 0 1rem;
    border: 1.5px solid var(--muted);
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .ghost-button:hover {
    border-style: dashed;
  }

  /* ---------- Enseigne de taxi (module signature) ---------- */

  .sign {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    min-height: 52px;
    min-width: 11rem;
    padding: 0.375rem 1.375rem;
    border: 2px solid var(--amber);
    /* Toit arrondi, base droite : le lumineux posé sur le taxi. */
    border-radius: 12px 12px 4px 4px;
    font-weight: 800;
  }

  .sign-lamp {
    font-size: 1rem;
    letter-spacing: 0.2em;
    line-height: 1.1;
  }

  .sign-action {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .sign-free {
    background: transparent;
    color: var(--amber);
  }

  .sign-free:hover .sign-action {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sign-busy {
    background: var(--amber);
    color: var(--bg);
    box-shadow: var(--glow);
    animation: lamp 2.4s ease-in-out infinite;
  }

  .sign-busy:hover .sign-action {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @keyframes lamp {
    50% {
      box-shadow: 0 0 6px rgb(255 176 0 / 0.25);
    }
  }

  /* ---------- Messages ---------- */

  /* Blocs sans gap : un message vide ne prend aucune place (CA-11) mais sa région live reste
     dans l'arbre d'accessibilité, pour que ce qui s'y écrit ensuite soit annoncé. */
  .top,
  .feedback {
    display: block;
  }

  .messages,
  .alerts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .message,
  .notices:has(li) {
    margin: 0.625rem 0 0;
    padding: 0.5rem 0.875rem;
    border-left: 4px solid var(--amber);
    background: var(--panel);
    font-size: 0.9375rem;
  }

  .notices {
    display: flex;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }

  .notices:has(li) {
    padding-block: 0.375rem;
    padding-right: 0.375rem;
  }

  .notices-text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .messages :global(li + li) {
    margin-top: 0.25rem;
  }

  .dismiss {
    flex: none;
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.875rem;
    border: 1.5px solid var(--muted);
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    font-size: 0.875rem;
  }

  .dismiss:hover {
    border-style: dashed;
  }

  .ended {
    margin: 0;
    color: var(--muted);
  }

  /* Confirmation de copie : coche ET texte, jamais la couleur seule. Sa largeur est réservée
     même vide (spec, « Écrans ») : « ✓ Lien copié. » y tient, et les boutons voisins restent
     en place quand elle apparaît ou s'efface. */
  .copy-status {
    box-sizing: border-box;
    width: 7.5rem;
    min-height: 1.35em;
    margin: 0;
    color: var(--amber);
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* Coche décorative : le texte de remplacement vide la retire de ce que lit un lecteur
     d'écran, qui annonce seulement « Lien copié. ». */
  .copy-status:not(:empty)::before {
    content: "✓ " / "";
  }

  /* ---------- Repli de copie ---------- */

  .copy-dialog {
    box-sizing: border-box;
    width: min(34rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 1.25rem;
    border: 2px solid var(--amber);
    border-radius: 14px;
    background: var(--panel);
    color: var(--text);
  }

  .copy-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .copy-dialog-title {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .copy-dialog-text {
    margin: 0 0 0.875rem;
    font-size: 0.9375rem;
  }

  .copy-dialog-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0 0 1rem;
  }

  .copy-dialog-field label {
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .copy-dialog-field input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .copy-dialog-actions {
    display: flex;
    justify-content: end;
    margin: 0;
  }

  /* ---------- Disposition des écrans ---------- */

  .layout {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  main[data-screen="setup"] .top,
  main[data-screen="setup"] .layout {
    max-width: 56rem;
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 60rem) {
    main[data-screen="meter"] .layout,
    main[data-screen="ticket"] .layout {
      grid-template-columns: minmax(0, 1fr) 21.5rem;
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
  }

  main:not([data-screen="setup"]) .setup-only {
    display: none;
  }

  main:not([data-screen="ticket"]) .ticket-only {
    display: none;
  }

  main[data-screen="ticket"] .controls {
    display: none;
  }

  .label {
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------- Afficheur LED (module signature) ---------- */

  .board {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .board-main {
    display: grid;
    gap: 0.625rem;
  }

  .led {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.875rem 1.125rem;
    background: var(--led);
    border-radius: 12px;
    box-shadow: inset 0 2px 12px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }

  /* Voyant d'alerte de l'afficheur (CL-2, CL-6) : icône ET texte, jamais la couleur seule. */
  .alerts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .alerts :global(li) {
    color: var(--amber);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .alerts :global(li:first-child) {
    margin-top: 0.5rem;
  }

  .alerts :global(li)::before {
    content: "⚠ ";
  }

  .led-readout {
    /* Doto est à chasse fixe (0,6 em) : la taille suit le nombre de caractères (--digits,
       posé par le script) pour que le montant tienne toujours sur une ligne. */
    --digits: 4;
    display: flex;
    align-items: baseline;
    gap: 0.15em;
    font-family: var(--font-digits);
    font-weight: 900;
    font-size: min(5.5rem, calc(100cqi / (var(--digits) * 0.6 + 0.4)));
    line-height: 1;
    white-space: nowrap;
    color: var(--amber);
  }

  .led-currency {
    font-size: 0.32em;
  }

  .led-digits {
    position: relative;
    z-index: 0;
