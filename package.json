{
  "name": "collection-paperasse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build && node scripts/assemble.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "check": "pnpm -r check && tsc -p tsconfig.json",
    "lint": "node scripts/check-invisible.mjs && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build:e2e && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
